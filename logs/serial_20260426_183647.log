/dev/block/by-name/metadata               /metadata    ext4    nodev,noatime,nosuid               wait,check,formattable,first_stage_mount
/dev/block/by-name/userdata               /data        ext4    nodev,noatime,nosuid,errors=panic  wait,check,formattable,quota,fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption
/devices/platform/axi/*.pcie/*.usb/*/usb*  auto         auto    defaults                           voldmanaged=usb:auto
/devices/platform/axi/*.usb/usb*           auto         auto    defaults                           voldmanaged=usb:auto
