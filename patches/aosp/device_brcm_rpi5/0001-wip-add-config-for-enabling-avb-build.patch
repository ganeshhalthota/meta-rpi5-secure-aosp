From 577023e076192ebfd0e9009b452e8bb2004eb768 Mon Sep 17 00:00:00 2001
From: ghalthot <ghalthot@qti.qualcomm.com>
Date: Tue, 10 Mar 2026 12:32:26 +0530
Subject: [PATCH] wip: add config for enabling avb build

---
 BoardConfig.mk         | 32 ++++++++++++++++++++++++++++++++
 device.mk              | 13 +++++++++++--
 ramdisk/fstab.rpi5.avb | 11 +++++++++++
 3 files changed, 54 insertions(+), 2 deletions(-)
 create mode 100644 ramdisk/fstab.rpi5.avb

diff --git a/BoardConfig.mk b/BoardConfig.mk
index a93cb46..5b685a4 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -61,6 +61,38 @@ BOARD_KERNEL_CMDLINE += androidboot.selinux=permissive
 # Treble
 TARGET_COPY_OUT_VENDOR := vendor
 
+# AVB (Android Verified Boot) — set RPI5_ENABLE_AVB=true to enable
+RPI5_ENABLE_AVB ?= false
+
+ifeq ($(RPI5_ENABLE_AVB),true)
+BOARD_AVB_ENABLE := true
+BOARD_AVB_ALGORITHM := SHA256_RSA4096
+BOARD_AVB_KEY_PATH := external/avb/test/data/testkey_rsa4096.pem
+BOARD_AVB_ROLLBACK_INDEX := 0
+BOARD_AVB_VBMETA_PARTITION_SIZE := 4194304          # 4MB — matches p4 in aosp_signed.yaml
+
+# Skip boot verification (RPi5 firmware doesn't support AVB)
+BOARD_AVB_MAKE_VBMETA_IMAGE_ARGS += --flags 2
+
+# System partition (chained descriptor)
+BOARD_AVB_VBMETA_SYSTEM := system
+BOARD_AVB_VBMETA_SYSTEM_KEY_PATH := external/avb/test/data/testkey_rsa4096.pem
+BOARD_AVB_VBMETA_SYSTEM_ALGORITHM := SHA256_RSA4096
+BOARD_AVB_VBMETA_SYSTEM_ROLLBACK_INDEX := 0
+BOARD_AVB_VBMETA_SYSTEM_ROLLBACK_INDEX_LOCATION := 1
+
+# Vendor partition (chained descriptor)
+BOARD_AVB_VBMETA_VENDOR := vendor
+BOARD_AVB_VBMETA_VENDOR_KEY_PATH := external/avb/test/data/testkey_rsa4096.pem
+BOARD_AVB_VBMETA_VENDOR_ALGORITHM := SHA256_RSA4096
+BOARD_AVB_VBMETA_VENDOR_ROLLBACK_INDEX := 0
+BOARD_AVB_VBMETA_VENDOR_ROLLBACK_INDEX_LOCATION := 2
+
+# Kernel cmdline — vbmeta is p4, RPi5 firmware doesn't verify so state=orange
+BOARD_KERNEL_CMDLINE += androidboot.vbmeta.device=/dev/block/mmcblk0p4
+BOARD_KERNEL_CMDLINE += androidboot.verifiedbootstate=orange
+endif
+
 # Wifi
 BOARD_WLAN_DEVICE := bcmdhd
 BOARD_HOSTAPD_DRIVER := NL80211
diff --git a/device.mk b/device.mk
index 99a70a2..99d90e8 100644
--- a/device.mk
+++ b/device.mk
@@ -134,10 +134,19 @@ PRODUCT_COPY_FILES += \
 PRODUCT_PACKAGES += \
     com.android.hardware.power
 
-# Ramdisk
+# Ramdisk — fstab selection depends on AVB
+ifeq ($(BOARD_AVB_ENABLE),true)
+PRODUCT_COPY_FILES += \
+    $(DEVICE_PATH)/ramdisk/fstab.rpi5.avb:$(TARGET_COPY_OUT_RAMDISK)/fstab.rpi5 \
+    $(DEVICE_PATH)/ramdisk/fstab.rpi5.avb:$(TARGET_COPY_OUT_VENDOR)/etc/fstab.rpi5
+else
 PRODUCT_COPY_FILES += \
     $(DEVICE_PATH)/ramdisk/fstab.rpi5:$(TARGET_COPY_OUT_RAMDISK)/fstab.rpi5 \
-    $(DEVICE_PATH)/ramdisk/fstab.rpi5:$(TARGET_COPY_OUT_VENDOR)/etc/fstab.rpi5 \
+    $(DEVICE_PATH)/ramdisk/fstab.rpi5:$(TARGET_COPY_OUT_VENDOR)/etc/fstab.rpi5
+endif
+
+# Other ramdisk files
+PRODUCT_COPY_FILES += \
     $(DEVICE_PATH)/ramdisk/init.rpi5.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/hw/init.rpi5.rc \
     $(DEVICE_PATH)/ramdisk/init.rpi5.usb.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/hw/init.rpi5.usb.rc \
     $(DEVICE_PATH)/ramdisk/ueventd.rpi5.rc:$(TARGET_COPY_OUT_VENDOR)/etc/ueventd.rc
diff --git a/ramdisk/fstab.rpi5.avb b/ramdisk/fstab.rpi5.avb
new file mode 100644
index 0000000..ab452a5
--- /dev/null
+++ b/ramdisk/fstab.rpi5.avb
@@ -0,0 +1,11 @@
+# Android fstab file.
+# The filesystem that contains the filesystem checker binary (typically /system) cannot
+# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK
+
+#<src>                                     <mnt_point>  <type>  <mnt_flags and options>            <fs_mgr_flags>
+/dev/block/mmcblk0p5                       /system      ext4    ro,barrier=1                       wait,avb=vbmeta,first_stage_mount
+/dev/block/mmcblk0p6                       /vendor      ext4    ro,barrier=1                       wait,avb=vbmeta,first_stage_mount
+/dev/block/mmcblk0p7                       /metadata    ext4    nodev,noatime,nosuid               wait,check,formattable,first_stage_mount
+/dev/block/mmcblk0p3                       /data        ext4    nodev,noatime,nosuid,errors=panic  wait,check,formattable,quota
+/devices/platform/axi/*.pcie/*.usb/*/usb*  auto         auto    defaults                           voldmanaged=usb:auto
+/devices/platform/axi/*.usb/usb*           auto         auto    defaults                           voldmanaged=usb:auto
-- 
2.43.0

