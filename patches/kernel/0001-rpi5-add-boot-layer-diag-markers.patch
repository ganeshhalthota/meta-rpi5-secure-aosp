From f86c7009f9a1495b3614eba7b735fc6f448ac2de Mon Sep 17 00:00:00 2001
From: Ganesh Halthota <ganesh.rvec@gmail.com>
Date: Sat, 2 May 2026 22:39:26 +0530
Subject: [PATCH] rpi5: add RPi5-DIAG boot layer boundary markers

Add pr_notice() markers at the four boot-layer boundaries so that
layer transitions are visible in the serial console log under any
loglevel. All messages use the RPi5-DIAG: prefix to make them
grep-able in captured logs.

  Layer 1 - arch init entry: first statement in start_kernel(),
            immediately after bootloader hands off to the kernel.

  Layer 2 - console/mm up: after console_init() so the message is
            guaranteed to be flushed to serial immediately (the
            early console is registered by this point on RPi5).

  Layer 3 - driver probe begin: just before do_initcalls() in
            do_basic_setup(); marks the start of the initcall
            driver probe sequence (visible via initcall_debug).

  Layer 4 - userspace exec begin: just before run_init_process()
            in kernel_init(); marks end of in-kernel init and
            the hand-off to /init.

Markers use pr_err (level 3) so they appear even at the default
loglevel=4 without needing ignore_loglevel.
No security-sensitive values are emitted.
---
 init/main.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/init/main.c b/init/main.c
index 1b4c90e0a56f..2889f863d379 100644
--- a/init/main.c
+++ b/init/main.c
@@ -1038,6 +1038,8 @@ void start_kernel(void)
 	char *command_line;
 	char *after_dashes;
 
+	pr_err("RPi5-DIAG: Layer 1 start_kernel entry (bootloader handoff complete)\n");
+
 	set_task_stack_end_magic(&init_task);
 	smp_setup_processor_id();
 	debug_objects_early_init();
@@ -1178,6 +1180,8 @@ void start_kernel(void)
 		panic("Too many boot %s vars at `%s'", panic_later,
 		      panic_param);
 
+	pr_err("RPi5-DIAG: Layer 2 console_init complete (early console up, mm init done)\n");
+
 	lockdep_init();
 
 	/*
@@ -1500,6 +1504,7 @@ static void __init do_basic_setup(void)
 	driver_init();
 	init_irq_proc();
 	do_ctors();
+	pr_err("RPi5-DIAG: Layer 3 do_initcalls entry (driver probe sequence begins)\n");
 	do_initcalls();
 }
 
@@ -1628,6 +1633,8 @@ static int __ref kernel_init(void *unused)
 
 	do_sysctl_args();
 
+	pr_err("RPi5-DIAG: Layer 4 kernel_init userspace exec (all drivers probed, exec /init)\n");
+
 	if (ramdisk_execute_command) {
 		ret = run_init_process(ramdisk_execute_command);
 		if (!ret)
-- 
